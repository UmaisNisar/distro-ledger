# Copy to `.env`. Used by docker-compose (local) and docker-compose.prod.yml (VM).

# Long random string, >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- Production (docker-compose.prod.yml) only ---
# Domain that points (A record) at your VM's public IP; Caddy gets HTTPS for it.
DOMAIN=distro.example.com
# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me-strong-password
